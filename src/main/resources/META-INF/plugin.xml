<idea-plugin>
  <id>io.github.balconyjh.trace32</id>
  <name>Toolkit for Lauterbach TRACE32®</name>
  <version>0.2.0</version>
  <vendor email="73932916+BalconyJH@users.noreply.github.com" url="https://github.com/BalconyJH/intellij-trace32">BalconyJH</vendor>
  <description><![CDATA[
    Kotlin-based editing support for Lauterbach TRACE32® PRACTICE (.cmm/.cmmt):
    syntax highlighting, contextual completion, documentation, parameter hints,
    structure and symbol navigation, static script call hierarchy, comments and folding,
    indentation formatting, local usages and rename with conflict checks.
    Optional native LSP integration with a separately installed t32ls server.<br/><br/>
    Unofficial community project. Not affiliated with or endorsed by Lauterbach GmbH.<br/>
    TRACE32® is a registered trademark of Lauterbach GmbH.
  ]]></description>
  <idea-version since-build="263" until-build="263.*"/>
  <depends>com.intellij.modules.platform</depends>
  <depends optional="true" config-file="cmm-lsp.xml">com.intellij.modules.lsp</depends>
  <extensions defaultExtensionNs="com.intellij">
    <fileType name="Lauterbach TRACE32® PRACTICE" language="CMM" implementationClass="io.github.balconyjh.trace32.cmm.CmmFileType" fieldName="INSTANCE" extensions="cmm;CMM;cmmt;CMMT"/>
    <lang.parserDefinition language="CMM" implementationClass="io.github.balconyjh.trace32.cmm.CmmParserDefinition"/>
    <lang.syntaxHighlighterFactory language="CMM" implementationClass="io.github.balconyjh.trace32.cmm.CmmSyntaxHighlighter$Factory"/>
    <lang.commenter language="CMM" implementationClass="io.github.balconyjh.trace32.cmm.CmmCommenter"/>
    <lang.foldingBuilder language="CMM" implementationClass="io.github.balconyjh.trace32.cmm.CmmFoldingBuilder"/>
    <lang.braceMatcher language="CMM" implementationClass="io.github.balconyjh.trace32.cmm.CmmBraceMatcher"/>
    <completion.contributor language="CMM" implementationClass="io.github.balconyjh.trace32.cmm.CmmCompletionContributor"/>
    <lang.documentationProvider language="CMM" implementationClass="io.github.balconyjh.trace32.cmm.CmmDocumentationProvider"/>
    <lang.parameterInfo language="CMM" implementationClass="io.github.balconyjh.trace32.cmm.CmmParameterInfoHandler"/>
    <lang.structureViewBuilder language="CMM" implementationClass="io.github.balconyjh.trace32.cmm.CmmStructureViewFactory"/>
    <annotator language="CMM" implementationClass="io.github.balconyjh.trace32.cmm.CmmAnnotator"/>
    <lang.formatter language="CMM" implementationClass="io.github.balconyjh.trace32.cmm.CmmFormattingModelBuilder"/>
    <lang.quoteHandler language="CMM" implementationClass="io.github.balconyjh.trace32.cmm.CmmQuoteHandler"/>
    <colorSettingsPage implementation="io.github.balconyjh.trace32.cmm.CmmColorSettingsPage"/>
    <lang.findUsagesProvider language="CMM" implementationClass="io.github.balconyjh.trace32.cmm.CmmFindUsagesProvider"/>
    <referencesSearch implementation="io.github.balconyjh.trace32.cmm.CmmReferenceSearch"/>
    <lang.namesValidator language="CMM" implementationClass="io.github.balconyjh.trace32.cmm.CmmNamesValidator"/>
    <renamePsiElementProcessor implementation="io.github.balconyjh.trace32.cmm.CmmRenameProcessor"/>
    <liveTemplateContext contextId="CMM" implementation="io.github.balconyjh.trace32.cmm.CmmTemplateContextType"/>
    <defaultLiveTemplates file="/liveTemplates/CMM"/>
    <enterHandlerDelegate implementation="io.github.balconyjh.trace32.cmm.CmmEnterHandler"/>
    <fileBasedIndex implementation="io.github.balconyjh.trace32.cmm.navigation.CmmNavigationIndex"/>
    <gotoSymbolContributor implementation="io.github.balconyjh.trace32.cmm.CmmSymbolContributor"/>
    <callHierarchyProvider language="CMM" implementationClass="io.github.balconyjh.trace32.cmm.CmmCallHierarchyProvider"/>
    <projectConfigurable parentId="language" id="io.github.balconyjh.trace32.cmm.settings"
                         displayName="Lauterbach TRACE32®" instance="io.github.balconyjh.trace32.cmm.CmmSettingsConfigurable"/>
  </extensions>
</idea-plugin>
